<!-- Rust 学习指南 · 页面级防护：mdBook 默认的左右巨型翻页按钮在这里统一移除。
     内联样式跟着 HTML 走，就算外部 CSS 没加载（缓存/断网）也不会冒出大按钮。 -->
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<style>
  .nav-wide-wrapper, .nav-wrapper, .nav-chapters, .mobile-nav-chapters, .chapter-nav-keys {
    display: none !important;
  }
</style>
<script>
  (function () {
    'use strict';
    var JUNK = '.nav-wide-wrapper, .nav-wrapper, .chapter-nav-keys, nav.chapter-nav-keys, a.nav-chapters, .mobile-nav-chapters';
    function clean() {
      var junk = document.querySelectorAll(JUNK);
      for (var i = 0; i < junk.length; i++) {
        var el = junk[i];
        el.style.display = 'none';
        if (el.parentNode) { el.parentNode.removeChild(el); }
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', clean);
    } else {
      clean();
    }
    window.addEventListener('load', clean);

    // ←/→ 翻章：mdBook 默认依赖 .nav-chapters 锚点，已删除，这里改读正文末尾导航的链接。
    document.addEventListener('keydown', function (e) {
      if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) { return; }
      var t = e.target;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) { return; }
      var link = null;
      if (e.key === 'ArrowLeft') { link = document.querySelector('.chapter-nav-prev'); }
      else if (e.key === 'ArrowRight') { link = document.querySelector('.chapter-nav-next'); }
      if (link && link.href) { e.preventDefault(); window.location.href = link.href; }
    });
  })();
</script>
<script>
// Local Rust playground shim: rewrites play.rust-lang.org requests to the
// local runner started by tools/serve_book.py.  Falls back to the official
// playground when the local runner is not running.
(function () {
    'use strict';
    var LOCAL = 'http://127.0.0.1:3030';
    var REMOTE = 'https://play.rust-lang.org';
    if (['localhost', '127.0.0.1', '[::1]'].indexOf(location.hostname) < 0) { return; }
    // 本地运行器第一次点 Run 要先编译依赖（几十秒），把 book.js 默认的 6 秒超时放宽。
    window.RUSTBOOK_FETCH_TIMEOUT = 180000;
    var realFetch = window.fetch ? window.fetch.bind(window) : null;
    if (!realFetch) { return; }

    window.RUSTBOOK_PLAYGROUND = LOCAL;

    window.fetch = function (input, init) {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        if (url.indexOf(REMOTE + '/') !== 0) {
            return realFetch(input, init);
        }
        var path = url.slice(REMOTE.length);
        return realFetch(LOCAL + path, init).catch(function () {
            return realFetch(input, init);
        });
    };

    function pill(text, kind, life) {
        var el = document.createElement('div');
        el.textContent = text;
        el.style.cssText = 'position:fixed;left:12px;bottom:10px;z-index:9999;' +
            'font:12px/1.6 ui-monospace,Consolas,monospace;padding:2px 10px;' +
            'border-radius:10px;opacity:0;transition:opacity .4s;pointer-events:none;' +
            (kind === 'on' ? 'background:#0b6e4f;color:#eafff5;'
                           : 'background:#7a4a00;color:#fff6e5;');
        el.title = kind === 'on'
            ? '代码在本地编译运行（rustc/cargo，离线）'
            : '本地运行器未启动，Run 会走官方 Playground';
        document.body.appendChild(el);
        requestAnimationFrame(function () { el.style.opacity = '0.95'; });
        setTimeout(function () {
            el.style.opacity = '0';
            setTimeout(function () { el.remove(); }, 600);
        }, life);
    }

    realFetch(LOCAL + '/health').then(function (r) { return r.json(); })
        .then(function (info) {
            if (info && info.ok) {
                window.RUSTBOOK_PLAYGROUND_OK = true;
                var warming = info.warming ? '（正在预编译依赖）' : '';
                pill('本地运行器 已连接 · ' + info.crates.length + ' 个 crate' + warming, 'on', 6000);
            }
        })
        .catch(function () {
            window.RUSTBOOK_PLAYGROUND_OK = false;
            pill('未检测到本地运行器，使用官方 Playground', 'off', 6000);
        });
})();
</script>
<script>
// 案例答案折叠面板：Ace 编辑器若在隐藏容器里初始化，尺寸会是 0，展开后要让它重新排版；
// 另外打印（含导出 PDF）前把所有答案临时展开，保证打印稿是完整的。
(function () {
    "use strict";
    function resizeAce(root) {
        if (!window.ace) { return; }
        var editors = root.querySelectorAll(".ace_editor");
        for (var i = 0; i < editors.length; i++) {
            try { window.ace.edit(editors[i]).resize(true); } catch (e) { /* 不是 Ace 容器 */ }
        }
    }
    document.addEventListener("toggle", function (e) {
        var d = e.target;
        if (d && d.tagName === "DETAILS" && d.open) { resizeAce(d); }
    }, true);
    var reopened = [];
    window.addEventListener("beforeprint", function () {
        reopened = [];
        var all = document.querySelectorAll("details.case-answer:not([open])");
        for (var i = 0; i < all.length; i++) { all[i].open = true; reopened.push(all[i]); }
    });
    window.addEventListener("afterprint", function () {
        for (var i = 0; i < reopened.length; i++) { reopened[i].open = false; }
        reopened = [];
    });
})();
</script>
